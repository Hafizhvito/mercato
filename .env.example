# Database (Neon PostgreSQL connection pool string)
DATABASE_URL="postgresql://user:password@ep-sample-123456.ap-southeast-1.aws.neon.tech/mercato?sslmode=verify-full"
TEST_DATABASE_URL="postgresql://user:password@ep-test-sample-789012.ap-southeast-1.aws.neon.tech/mercato?sslmode=verify-full"

# Redis and Rate Limiting (Upstash)
UPSTASH_REDIS_REST_URL="https://sample-redis-12345.upstash.io"
UPSTASH_REDIS_REST_TOKEN="sample_upstash_rest_token_here"

# Authentication (Better Auth)
BETTER_AUTH_SECRET="sample_32_character_random_auth_secret_value_here"
BETTER_AUTH_URL="http://localhost:3000"

# Application URL and Environment
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Object Storage (Cloudflare R2 or S3-compatible)
R2_ACCOUNT_ID="sample_cloudflare_account_id"
R2_ACCESS_KEY_ID="sample_r2_access_key_id"
R2_SECRET_ACCESS_KEY="sample_r2_secret_access_key"
R2_BUCKET_NAME="mercato-assets"
NEXT_PUBLIC_R2_PUBLIC_URL="https://assets.mercato.local"

# Indonesian Payments (Midtrans)
MIDTRANS_SERVER_KEY="SB-Mid-server-sample_server_key"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-sample_client_key"
MIDTRANS_IS_PRODUCTION="false"

# Global Payments (Stripe)
STRIPE_SECRET_KEY="sk_test_sample_stripe_secret_key"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_sample_stripe_publishable_key"
STRIPE_WEBHOOK_SECRET="whsec_sample_stripe_webhook_secret"

# Transactional Email (Resend)
RESEND_API_KEY="re_sample_resend_api_key"
EMAIL_FROM="Mercato <orders@mercato.local>"

# Background Workflows (Inngest)
INNGEST_EVENT_KEY="sample_inngest_event_key"
INNGEST_SIGNING_KEY="sample_inngest_signing_key"

# Observability (Sentry)
NEXT_PUBLIC_SENTRY_DSN=""
