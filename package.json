{
  "name": "mercato",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check src tests",
    "lint:fix": "biome check --write src tests",
    "format": "biome format --write src tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:test": "drizzle-kit migrate --config=drizzle.test.config.ts",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx --env-file=.env.local src/lib/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "prepare": "husky"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.14",
    "@hookform/resolvers": "6.0.2",
    "@t3-oss/env-nextjs": "0.13.11",
    "@upstash/ratelimit": "2.2.0",
    "@upstash/redis": "1.40.0",
    "better-auth": "1.7.14",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.64.0",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "^18.0.9",
    "drizzle-kit": "0.31.11",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "pino-pretty": "13.2.0",
    "postcss": "8.5.32",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
